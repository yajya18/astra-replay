# Replay configuration. Copy to `.env` (repository root or backend/) and edit.
# Every variable is optional: with nothing set, the app runs fully offline with the
# deterministic `mock` provider. All defaults live in backend/app/config.py.

# ---------------------------------------------------------------- providers
# mock | gemini | openai | anthropic | ollama
VLM_PROVIDER=mock
LLM_PROVIDER=mock

GEMINI_API_KEY=
GEMINI_VLM_MODEL=gemini-flash-latest
GEMINI_LLM_MODEL=gemini-flash-latest

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_VLM_MODEL=gpt-5.4-mini
OPENAI_LLM_MODEL=gpt-5.4-mini

ANTHROPIC_API_KEY=
ANTHROPIC_VLM_MODEL=claude-opus-5-5
ANTHROPIC_LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=low

OLLAMA_HOST=http://localhost:11434
OLLAMA_VLM_MODEL=qwen2.5vl:7b
OLLAMA_LLM_MODEL=qwen2.5vl:7b

PROVIDER_CONCURRENCY=4
PROVIDER_TIMEOUT_S=60
PROVIDER_MAX_RETRIES=4
PROVIDER_BACKOFF_BASE_S=1.5
PROVIDER_MAX_IMAGES=16
PROMPT_VERSION=v1

# ---------------------------------------------------------------- local models
# auto | sentence-transformers | hash
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=all-MiniLM-L6-v2
WHISPER_ENABLED=true
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ---------------------------------------------------------------- server
APP_NAME=Replay
DATA_DIR=data
DEMO_DIR=demo
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Also allows private LAN addresses so phones on your Wi-Fi can upload. Empty to disable.
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|10\.\d+\.\d+\.\d+|192\.168\.\d+\.\d+|172\.(1[6-9]|2\d|3[01])\.\d+\.\d+)(:\d+)?$
PUBLIC_BASE_URL=
LOG_LEVEL=INFO
RATE_LIMIT_JOBS=12
RATE_LIMIT_WINDOW_S=600
WORKER_CONCURRENCY=1
RETENTION_HOURS=24
CLEANUP_INTERVAL_S=3600
SEED_DEMOS_ON_STARTUP=true
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# ---------------------------------------------------------------- ingest
MAX_UPLOAD_MB=500
MAX_DURATION_S=600
MIN_DURATION_S=5
WORK_LONG_SIDE=720
WORK_FPS=30
WORK_PRESET=veryfast
WORK_CRF=23
AUDIO_SAMPLE_RATE=16000

# ---------------------------------------------------------------- motion
MOTION_FPS=4
MOTION_WIDTH=160
MOTION_SMOOTH_S=1.0
IDLE_PERCENTILE=25
IDLE_THRESHOLD_SCALE=1.0
IDLE_MIN_S=3
SCENE_THRESHOLD=27
SCENE_MIN_LEN_S=1.0

# ---------------------------------------------------------------- windows
WINDOW_S=4
WINDOW_STRIDE_S=3
WINDOW_MIN_S=1
FRAMES_PER_WINDOW=4
FRAMES_PER_WINDOW_HIGH_MOTION=8
FRAME_SAMPLE_FPS=10
FRAME_LONG_SIDE=512
SHARP_SEARCH_S=0.2

# ---------------------------------------------------------------- segmentation
MERGE_SIMILARITY=0.78
MERGE_GAP_S=1.5
MERGE_GAP_SIMILARITY=0.65
MAX_IDLE_MERGE_S=3
MIN_STEP_S=2
UNKNOWN_DROP_S=3
UNKNOWN_CONFIDENCE=0.3
BOUNDARY_REFINE_S=1.0

# ---------------------------------------------------------------- alignment
ALIGN_VERIFY_BELOW=0.45
ALIGN_MIN_SIMILARITY=0.2

# ---------------------------------------------------------------- media
KEYFRAME_WIDTH=480
HIGHLIGHT_SECONDS=60
HIGHLIGHT_MIN_S=20
HIGHLIGHT_MAX_S=180
HIGHLIGHT_STEP_MIN_S=2
HIGHLIGHT_STEP_MAX_S=6
HIGHLIGHT_TITLE_S=3
HIGHLIGHT_CLOSING_S=2.5
HIGHLIGHT_CROSSFADE_S=0.3
CLIP_CONCURRENCY=3

# ---------------------------------------------------------------- search
SEARCH_TOP_K=5
SEARCH_SEMANTIC_WEIGHT=0.6

# ---------------------------------------------------------------- frontend (build time)
# Empty = the browser calls the API on the same host at port 8000.
NEXT_PUBLIC_API_URL=
